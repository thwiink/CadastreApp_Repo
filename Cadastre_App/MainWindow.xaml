<Window x:Class="Cadastre_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cadastre_App"
        mc:Ignorable="d"
        Title="Cadastre" Height="500" Width="1200">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Frame Background="#FF03BA5D" Grid.Row="0" Grid.ColumnSpan="2" 
               Navigated="Frame_Navigated" NavigationUIVisibility="Hidden"/>

        <Image Source="/Resources/logo.png.png" 
               HorizontalAlignment="Left" Width="80" Height="80" Margin="10"/>

        <TextBlock Text="3Д КАДАСТР" 
                   FontSize="30" VerticalAlignment="Center" 
                   HorizontalAlignment="Left" Margin="100,0,0,0" 
                   FontFamily="Times New Roman"/>

        <StackPanel Grid.Row="0" Grid.Column="1" 
                    Orientation="Horizontal" 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="10">
            <Button Content="Добавить" Name="BtnAdd" Click="BtnAdd_Click" Width="90" Height="35" Margin="5" Background="LawnGreen"/>
            <Button Content="Список" Name="BtnList" Click="BtnList_Click" Width="90" Height="35" Margin="5" Background="LawnGreen"/>
            <Button Content="О программе" Name="BtnAbout" Click="BtnAbout_Click" Width="90" Height="35" Margin="5" Background="LawnGreen"/>
            <Button Content="Справка" Name="BtnHelp" Click="BtnHelp_Click" Width="90" Height="35" Margin="5" Background="LawnGreen"/>
            <Button Content="Пользователи" Name="BtnUsers" Click="BtnUsers_Click" Width="90" Height="35" Margin="5" Background="LawnGreen" Visibility="Visible"/>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Row="1" Grid.ColumnSpan="2" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>