    <Page x:Class="Cadastre_App.FullEditPage"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:Cadastre_App"
          mc:Ignorable="d" 
          d:DesignHeight="450" d:DesignWidth="800"
          Title="FullEditPage">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="10*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Кадастровый номер"></TextBlock>
            <TextBlock Text="Адрес" Grid.Row="1"></TextBlock>
            <TextBlock Text="Площадь" Grid.Row="2"></TextBlock>
            <TextBlock Text="Этажи" Grid.Row="3"></TextBlock>
            <TextBlock Text="Стоимость" Grid.Row="4"></TextBlock>
            <TextBlock Text="Тип" Grid.Row="5"></TextBlock>
            <TextBlock Text="Владелец" Grid.Row="6"></TextBlock>
            <TextBlock Text="Телефон" Grid.Row="7"></TextBlock>
            <TextBlock Text="Статус" Grid.Row="8"></TextBlock>

            <TextBox Text="{Binding CadastralNumber}" Grid.Column="1" Grid.Row="0"></TextBox>
            <TextBox Text="{Binding Adress}" Grid.Column="1" Grid.Row="1"></TextBox>
            <TextBox Text="{Binding Area}" Grid.Column="1" Grid.Row="2"></TextBox>
            <TextBox Text="{Binding Floors}" Grid.Column="1" Grid.Row="3"></TextBox>
            <TextBox Text="{Binding CadastralValue}" Grid.Column="1" Grid.Row="4"></TextBox>
            <ComboBox Text="{Binding ObjectTypes.}" Grid.Column="1" Grid.Row="5" x:Name="ComboTypes" DisplayMemberPath="TypeName" SelectedValuePath="ID"></ComboBox>
            <TextBox Text="{Binding OwnersID}" Grid.Column="1" Grid.Row="6"></TextBox>
            <TextBox Text="{Binding Owners.Phone}" Grid.Column="1" Grid.Row="7"></TextBox>
            <TextBox Text="{Binding Status}" Grid.Column="1" Grid.Row="8"></TextBox>
            <Button Content="Сохранить" Grid.ColumnSpan="2" Grid.Row="9" Name="BtnSave" Click="BtnSave_Click" Width="150" Height="30"></Button>
        </Grid>
    </Page>
