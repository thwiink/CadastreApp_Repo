<Page x:Class="Cadastre_App.UserManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление пользователями">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Список пользователей" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <DataGrid x:Name="DGridUsers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="80"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="85"/>
                <DataGridTextColumn Header="Пароль" Binding="{Binding Password}" Width="80"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="85"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button x:Name="BtnAddUser" Content="+ Добавить пользователя" Width="150" Margin="5" Click="BtnAddUser_Click" Background="GreenYellow"/>
            <Button x:Name="BtnDeleteUser" Content="- Удалить выбранного" Width="150" Margin="5" Click="BtnDeleteUser_Click" Background="Red"/>
        </StackPanel>
    </Grid>
</Page>